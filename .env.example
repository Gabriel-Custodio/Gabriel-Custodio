# Copie este arquivo para ".env" (na mesma pasta) e preencha. O ".env" NAO vai para o GitHub.

# Chave da API do Groq (https://console.groq.com/keys)
GROQ_API_KEY=cole_sua_chave_aqui

# Opcionais: o Groq troca os modelos a cada poucos meses. Se der erro de modelo,
# veja https://console.groq.com/docs/deprecations e atualize aqui.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Layout dos cortes (opcional).
# fit (padrao): o video ORIGINAL inteiro em 1080x1920, sem recorte e sem zoom (maxima nitidez).
# clipflow: layout antigo de 3 camadas (webcam recortada + gameplay com zoom; perde nitidez).
# CORTES_LAYOUT=fit
# Fundo do layout fit: blur (copia desfocada do proprio video, padrao) ou preto.
# CORTES_FUNDO=blur
